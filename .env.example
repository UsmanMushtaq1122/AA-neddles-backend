PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/neddles
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=30d
CORS_ORIGIN=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Neddles <no-reply@example.com>

# --- Low Stock Alert Cron Job ---
# Global fallback threshold used when a product's own lowStockThreshold is 0/unset
LOW_STOCK_THRESHOLD=10
# Cron expression — default: every day at 9:00 AM
LOW_STOCK_CRON=0 9 * * *
# Comma-separated list of admin email addresses that receive low-stock digests
ADMIN_EMAIL=admin@example.com
# Set to "false" to disable all scheduled jobs (e.g. when running multiple instances)
ENABLE_CRON_JOBS=true
# Products processed per batch during a scan (performance tuning for 10k+ catalogs)
INVENTORY_SCAN_BATCH_SIZE=500

# --- Newsletter Cron Job ---
# When to send pending newsletters (default: every day at 10:00 AM)
NEWSLETTER_CRON=0 10 * * *
# Subscribers per email batch (respect SMTP provider limits; 50 is safe)
NEWSLETTER_BATCH_SIZE=50
# Pause between batches in ms (2-5s recommended to avoid rate limits)
NEWSLETTER_BATCH_DELAY=3000
# Send attempts per subscriber before marking FAILED
NEWSLETTER_MAX_ATTEMPTS=3
# Display name used in the From header
NEWSLETTER_FROM_NAME=AA NEEDLES

# --- Order Reminder Cron Job ---
# When to email reminders for pending orders older than 24h (default: every day at 9:00 AM)
ORDER_REMINDER_CRON=0 9 * * *

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
